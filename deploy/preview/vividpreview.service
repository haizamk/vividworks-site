[Unit]
Description=Vividworks preview site (Express + static dist)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vividpreview/current
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target